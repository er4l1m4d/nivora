# Root environment for the combined Vercel project (frontend + /api).
# Vercel reads these from vercel.json `env` and/or Project → Settings → Environments.
# Copy values from backend/.env.example for the server-side vars.

DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/DB?sslmode=require
LLM_API_KEY=
LLM_API_BASE=https://api.b.ai/v1
LLM_MODEL=qwen3.8-flash
LLM_TIMEOUT_SECONDS=8
PAYMENTS_MODE=mock
SETTLEMENT_TOKEN=dev-settlement-token
DISPUTE_WINDOW_SECONDS=300
CORS_ORIGINS=https://qestia.vercel.app

# Frontend (baked at build time)
VITE_API_URL=
VITE_USE_MOCK=false
