# Backend environment (FastAPI on Vercel / local uvicorn)
# Copy to backend/.env for local dev. On Vercel these are set in Project → Settings → Environments.

# --- Database (Neon pooled connection string, port 6543) ---
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/DB?sslmode=require

# --- Generation (Track A) — LLM runs server-side; key never reaches the client ---
LLM_API_KEY=
LLM_API_BASE=https://api.b.ai/v1
LLM_MODEL=qwen3.8-flash
# Keep under the function timeout. Vercel Hobby caps functions at 10s, so the
# endpoint 503s fast and the frontend falls back to the local generator. On a
# plan with a higher maxDuration, raise this to match the model latency.
LLM_TIMEOUT_SECONDS=8

# --- Payments ---
PAYMENTS_MODE=mock
SETTLEMENT_TOKEN=dev-settlement-token
DISPUTE_WINDOW_SECONDS=300

# --- CORS (comma-separated allowlist) ---
CORS_ORIGINS=http://localhost:5173
